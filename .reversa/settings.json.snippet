{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "./harness cmd resume",
            "timeout": 12,
            "statusMessage": "Iniciando sessão do Harness..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./harness decisions --gate",
            "timeout": 10,
            "statusMessage": "Consolidando decisões..."
          }
        ]
      }
    ]
  }
}
