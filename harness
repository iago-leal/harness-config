#!/bin/bash
# Wrapper de execução local do Harness Core

# Caminhos relativos a partir da raiz do projeto (core vive em .harness/harness-core)
VENV_PYTHON=".harness/harness-core/.venv/bin/python3"
MAIN_PY=".harness/harness-core/src/main.py"

# Resolve o caminho absoluto baseado no diretório onde o script está
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ABS_VENV_PYTHON="$SCRIPT_DIR/$VENV_PYTHON"
ABS_MAIN_PY="$SCRIPT_DIR/$MAIN_PY"

# Valida a presença do core. Ele pode faltar quando a cópia vendored foi
# gitignorada e o repositório foi clonado sem reidratar — restaure do upstream.
if [ ! -f "$ABS_MAIN_PY" ]; then
    echo "Erro: O harness-core não foi encontrado em: $MAIN_PY" >&2
    echo "A cópia do core é regenerável a partir do upstream. Restaure-a com:" >&2
    echo "  ./harness upgrade        # instalação existente (usa o upstream_path do harness.toml)" >&2
    echo "  <upstream>/harness init <este-projeto>   # instalação nova" >&2
    exit 1
fi

# Valida a presença da venv
if [ ! -f "$ABS_VENV_PYTHON" ]; then
    echo "Erro: O ambiente virtual do harness-core não está configurado em: $VENV_PYTHON" >&2
    echo "Recrie a venv local:" >&2
    echo "  cd .harness/harness-core && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt" >&2
    echo "Ou restaure tudo a partir do upstream: ./harness upgrade" >&2
    exit 1
fi

# Executa o core repassando todos os argumentos
exec "$ABS_VENV_PYTHON" "$ABS_MAIN_PY" "$@"
